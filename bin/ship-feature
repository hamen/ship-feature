#!/usr/bin/env bash
# ship-feature — a small helper for the ship-feature workflow (see WORKFLOW.md).
#
# v1 commands:
#   ship-feature preflight   Assert the working copy is set up for step 4 (worktree, feature
#                            branch off origin/HEAD, excluded marker, ancestry). Non-zero on failure.
#   ship-feature relay [..]  Transparent pass-through to `pr-review-relay`: forwards all args, preserves
#                            stdout and the EXACT exit code, and prints (on stderr) a one-line reminder of
#                            what each code means for the workflow.
#   ship-feature plan-review [<file>] [--reviewers a,b,c] [--sequential]
#                            Step 2: fan an implementation PLAN (a file, stdin, or ./plan.md) out to a
#                            panel of agents for a read-only review; prints each review. Defaults the
#                            panel to SHIP_FEATURE_PLAN_REVIEWERS, then SHIP_FEATURE_REVIEWERS. The
#                            panel runs in PARALLEL by default: reviewers are independent, and running
#                            them one after another multiplies the per-reviewer timeout by the panel
#                            size (a 4-seat panel at the per-reviewer timeout each could sit for many
#                            minutes before
#                            printing a verdict). --sequential restores one-at-a-time, streaming each
#                            review as it lands, for when you want to watch a single reviewer work or
#                            to keep concurrent agent load down. Exit 0 clean, 3 not-clean, 1 usage
#                            error.
#   ship-feature help        This message.
#
# The workflow itself lives in WORKFLOW.md; this tool does not drive it. State/resume is intentionally
# NOT in v1. Bash 3.2-safe (no associative arrays, no ${x^}); no jq dependency.
set -uo pipefail

die()  { echo "✖ $*" >&2; exit 1; }
warn() { echo "  ! $*" >&2; }
ok()   { echo "  ✓ $*"; }

# Kill a process AND its whole descendant tree, children first. Walking by PPID
# (`pgrep -P`) rather than by process group is deliberate: `timeout` puts its child in
# a NEW process group, so a group-kill of the backgrounded job would miss the reviewer
# two levels down (subshell → $() → timeout → agent). Children-before-parent so a killed
# parent can't reparent its children to init before we've found them. pgrep is present on
# Linux and macOS. Best-effort (a process forking mid-sweep can still slip), which is why
# each reviewer also runs under a `timeout`.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$child"; done
  kill -TERM "$pid" 2>/dev/null || true
}

# Where WORKFLOW.md §1 says plans live. One canonical path, matching install.sh
# by construction — a reviewer found the alternative: deriving it from
# SHIP_FEATURE_CONFIG made the two disagree for anyone with a custom config, and
# `SHIP_FEATURE_CONFIG=/dev/null` (the ordinary way to say "no config") resolved
# the plans directory to `/dev`. That variable names a config FILE to read, not a
# relocation of the install. `SHIP_FEATURE_PLANS_DIR` is the explicit override.
SF_PLANS_DIR="${SHIP_FEATURE_PLANS_DIR:-$HOME/.config/ship-feature/plans}"

# Created on demand, not only by the installer. An existing install that updates
# the repository gets the new workflow — which tells its agent to write a plan
# here — while the directory still does not exist, and the first plan write
# fails. Best effort: this is a diagnostic path, not a reason to refuse a
# command. Mode 0700 for the same reason the installer sets it: a plan describes
# an unreleased change in a private repository. A symlink is left alone.
sf_ensure_plans_dir() {
  [ -e "$SF_PLANS_DIR" ] && return 0
  mkdir -p "$SF_PLANS_DIR" 2>/dev/null || return 0
  chmod 700 "$SF_PLANS_DIR" 2>/dev/null || true
}

# Load ~/.config/ship-feature/config as plain KEY=value lines — NEVER shell-`source`d, and only known
# SHIP_FEATURE_* keys are honored. Environment variables win over the file.
load_config() {
  local cfg="${SHIP_FEATURE_CONFIG:-$HOME/.config/ship-feature/config}" key val
  # The shared pins are read whether or not THIS file exists — a machine can perfectly well have
  # pr-review-relay configured and no ship-feature config at all, and the early return below
  # would otherwise skip the fallback entirely. Found by the test that asserts the shared file is
  # read, running with SHIP_FEATURE_CONFIG=/dev/null.
  [ -f "$cfg" ] || { load_shared_panel_config; return 0; }
  # `|| [ -n "$key$val" ]` so a file with NO FINAL NEWLINE does not lose its last line. Without
  # it, `read` returns non-zero on that line and the loop exits before the case runs —
  # pr-review-relay's parser reads it, so the SAME file would select different models in the two
  # tools, which is the drift this whole change exists to remove.
  while IFS='=' read -r key val || [ -n "$key$val" ]; do
    case "$key" in ''|\#*) continue;; esac
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="${val%%[[:space:]]#*}"                                                   # strip an inline "# comment"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"     # trim surrounding space
    case "$key" in
      # Use ${VAR+x} (is it DEFINED?) not ${VAR:-} (is it non-empty?), so an explicitly empty environment
      # value (e.g. SHIP_FEATURE_REVIEWERS=) wins over the config file and disables it.
      SHIP_FEATURE_WORKTREE_ROOT) [ -n "${SHIP_FEATURE_WORKTREE_ROOT+x}" ] || SHIP_FEATURE_WORKTREE_ROOT="$val" ;;
      SHIP_FEATURE_EXCLUDE_MARKER) [ -n "${SHIP_FEATURE_EXCLUDE_MARKER+x}" ] || SHIP_FEATURE_EXCLUDE_MARKER="$val" ;;
      SHIP_FEATURE_DENYLIST) [ -n "${SHIP_FEATURE_DENYLIST+x}" ] || SHIP_FEATURE_DENYLIST="$val" ;;
      SHIP_FEATURE_REVIEWERS) [ -n "${SHIP_FEATURE_REVIEWERS+x}" ] || SHIP_FEATURE_REVIEWERS="$val" ;;
      SHIP_FEATURE_PLAN_REVIEWERS) [ -n "${SHIP_FEATURE_PLAN_REVIEWERS+x}" ] || SHIP_FEATURE_PLAN_REVIEWERS="$val" ;;
      # NON-EMPTY (${VAR:-}), NOT ${VAR+x} like the keys above — and the difference matters.
      # Those keys treat an explicitly empty value as a deliberate "disable"; a timeout has no such
      # meaning, an empty one is just absent. With ${VAR+x} an exported `SHIP_FEATURE_PLAN_TIMEOUT=`
      # would block THIS file while load_shared_panel_config, which tests non-empty, still filled
      # from the shared AGENT_TIMEOUT — silently deleting this rung of the ladder.
      #
      # It was environment-only until now, alone among the SHIP_FEATURE_* keys, which is why writing
      # it into this file did nothing at all. Demonstrated the hard way: the line was added here and
      # the next plan review still ran on the old default.
      # `export -n` for the same reason load_shared_panel_config does it, and the first draft of
      # this change fixed that site and missed this one. A plain assignment does NOT clear an
      # inherited export attribute, so a caller that exported the name — even empty — would have
      # THIS file's value cross into the pr-review-relay child. Reproduced before fixing:
      # `export SHIP_FEATURE_PLAN_TIMEOUT=` plus `SHIP_FEATURE_PLAN_TIMEOUT=420` in this file put
      # `SF=420` in the child's environment. plan-review's budget is plan-review's alone.
      SHIP_FEATURE_PLAN_TIMEOUT)
        if [ -z "${SHIP_FEATURE_PLAN_TIMEOUT:-}" ]; then
          export -n SHIP_FEATURE_PLAN_TIMEOUT 2>/dev/null || true
          SHIP_FEATURE_PLAN_TIMEOUT="$val"
        fi ;;
      # The model pins. Same precedence as the keys above — the environment wins, the file
      # fills in.
      #
      # These are the only keys here NOT named SHIP_FEATURE_*, and the names are not ours to
      # change: CURSOR_REVIEW_MODEL and PR_RELAY_OPENCODE_MODEL are read by `pr-review-relay`
      # as well, and one setting should configure both tools. That is also why they are
      # EXPORTED rather than merely assigned — `relay` runs pr-review-relay as a CHILD process,
      # and a plain shell variable does not cross that boundary.
      #
      # They were environment-only until now, which meant the panel was described in two
      # places: who sits on it here, what they actually run in ~/.zshrc. One file says both
      # now, so a seat and its model cannot drift apart — and a run with no shell profile (a
      # cron job, a fresh machine) gets the same panel as an interactive one instead of
      # silently falling back to a bundled default.
      #
      # NON-EMPTY (${VAR:-}), unlike the keys above: an explicitly empty SHIP_FEATURE_REVIEWERS
      # means "disable", which is a real thing to want, but an empty model pin means nothing at
      # all. Treating it as "defined" would let `CURSOR_REVIEW_MODEL=` block both this file and
      # the shared one, leaving ship-feature on its built-in default while pr-review-relay used
      # the configured value — the same inputs, two different models.
      KIMI3_REVIEW_MODEL) [ -n "${KIMI3_REVIEW_MODEL:-}" ] || export KIMI3_REVIEW_MODEL="$val" ;;
      CURSOR_REVIEW_MODEL) [ -n "${CURSOR_REVIEW_MODEL:-}" ] || export CURSOR_REVIEW_MODEL="$val" ;;
      GROK45HIGH_REVIEW_MODEL) [ -n "${GROK45HIGH_REVIEW_MODEL:-}" ] || export GROK45HIGH_REVIEW_MODEL="$val" ;;
      PR_RELAY_OPENCODE_MODEL) [ -n "${PR_RELAY_OPENCODE_MODEL:-}" ] || export PR_RELAY_OPENCODE_MODEL="$val" ;;
    esac
  done < "$cfg"

  load_shared_panel_config
}

# The SHARED PANEL config: pr-review-relay's own file, read here as the LAST fallback — who sits on
# the panel (REVIEWERS, PLAN_REVIEWERS), what each seat runs (MODEL_*), and how long each gets
# (AGENT_TIMEOUT).
#
# Renamed from load_shared_model_pins: it stopped being only about model pins when REVIEWERS and
# PLAN_REVIEWERS moved here, and a name that lies is how the next key ends up in a fourth place.
#
# Both tools review with the same seats on the same accounts, so which model a seat runs is a
# property of the machine, not of the tool that happens to be invoking it. pr-review-relay
# already keeps that in one place, keyed by SEAT name, and it has carried `MODEL_kimi3` since
# 2026-08-14 with a comment saying it would take effect once ship-feature learned to read this
# file. This is that.
#
# Keyed by seat means keyed by seat: the relay's `grok` seat and plan-review's `grok45high` seat
# are DIFFERENT seats — same vendor, different effort — so `MODEL_grok` is not read here and
# `MODEL_grok45high` is the key for this one. Mapping the relay's key onto this seat would
# silently give a high-effort plan review the relay's medium-effort pin.
#
# Without it the pin lives in two files at once and they drift: whichever one you edit, the
# other keeps its old value and nothing complains, because both are valid config.
#
# Precedence, lowest last: environment > ship-feature's own config > this file. It is called at
# the END of load_config for exactly that reason — by the time it runs, every key it touches is
# already set if either higher source provided one.
#
# `MODEL_opencode` is deliberately NOT mapped. That seat belongs to pr-review-relay, which reads
# this file itself; exporting PR_RELAY_OPENCODE_MODEL from here would push an environment value
# on top of the relay's own config and beat it, which is the opposite of consolidating.
load_shared_panel_config() {
  # ${HOME:-}, not $HOME: under `set -u` an unset HOME aborts the whole command, and a caller
  # that sets both ship-feature paths explicitly has every right not to have one.
  local cfg="${PR_RELAY_CONFIG:-${HOME:-}/.config/pr-review-relay/config}" key val
  # LAST VALUE WINS within this file, as in pr-review-relay's own parser. Guarding only on "is it
  # set" would keep the FIRST of two `REVIEWERS=` lines here while the relay kept the last — a
  # valid file handing the two tools different panels, which is exactly what reading one file is
  # meant to prevent. These flags say "a HIGHER source already provided this", which is the thing
  # that must not be overwritten; a later line of this same file may.
  local from_env_kimi3=1 from_env_cursor=1 from_env_grok=1 from_env_rev=1 from_env_plan=1 from_env_timeout=1
  [ -n "${KIMI3_REVIEW_MODEL:-}" ] || from_env_kimi3=0
  [ -n "${CURSOR_REVIEW_MODEL:-}" ] || from_env_cursor=0
  [ -n "${GROK45HIGH_REVIEW_MODEL:-}" ] || from_env_grok=0
  [ -n "${SHIP_FEATURE_REVIEWERS+x}" ] || from_env_rev=0
  [ -n "${SHIP_FEATURE_PLAN_REVIEWERS+x}" ] || from_env_plan=0
  # BOTH names, because both sit ABOVE this file on the ladder: SHIP_FEATURE_PLAN_TIMEOUT (rungs 1-2)
  # and PR_RELAY_AGENT_TIMEOUT (rung 3, the relay's own documented environment override). Guard on
  # only the first and a machine exporting the second gets that value in pr-review-relay and this
  # file's value here — the same inputs producing two different timeouts, which is the whole failure
  # this mapping exists to remove.
  [ -n "${SHIP_FEATURE_PLAN_TIMEOUT:-}" ] || [ -n "${PR_RELAY_AGENT_TIMEOUT:-}" ] || from_env_timeout=0
  [ -f "$cfg" ] || return 0
  while IFS='=' read -r key val || [ -n "$key$val" ]; do
    # Strip a leading UTF-8 BOM, as pr-review-relay's own parser does (lib-panel.sh). Without it
    # the first key of a BOM'd file reads as "\ufeffMODEL_kimi3" here and as "MODEL_kimi3" there:
    # one file, two different models, which is the whole failure this change removes.
    key="${key#$'\xef\xbb\xbf'}"
    case "$key" in ''|\#*) continue;; esac
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="${val%%[[:space:]]#*}"                                                   # strip an inline "# comment"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"     # trim surrounding space
    # NON-EMPTY here, not merely DEFINED. The SHIP_FEATURE_* keys use ${VAR+x} so that an
    # explicitly empty value can DISABLE a setting on purpose; a model pin has no such meaning —
    # an empty one is just absent. With ${VAR+x}, `CURSOR_REVIEW_MODEL=` would block this file and
    # leave ship-feature on its built-in default while pr-review-relay used the shared value: the
    # same inputs, two different models.
    case "$key" in
      MODEL_kimi3)      [ "$from_env_kimi3" = 1 ] || export KIMI3_REVIEW_MODEL="$val" ;;
      MODEL_cursor)     [ "$from_env_cursor" = 1 ] || export CURSOR_REVIEW_MODEL="$val" ;;
      MODEL_grok45high) [ "$from_env_grok" = 1 ] || export GROK45HIGH_REVIEW_MODEL="$val" ;;
      # WHO sits on the panel, from the same file for the same reason the models are. These two
      # were already duplicated across the two configs — identical today, free to drift tomorrow,
      # with nothing to notice it because both files are valid. A panel that differs between the
      # plan gate and the PR gate is the kind of difference you discover from a verdict.
      #
      # ${VAR+x} semantics here, unlike the model pins above: an explicitly empty
      # SHIP_FEATURE_REVIEWERS means "no injected quorum" on purpose, and that has to survive a
      # value in this file. (Captured in the flags above, before the loop.)
      #
      # NOT exported, unlike the model pins: the panel is passed to pr-review-relay as
      # `--reviewers` ARGUMENTS, in-process. The pins have to cross into the child, these do not.
      REVIEWERS)        [ "$from_env_rev" = 1 ] || SHIP_FEATURE_REVIEWERS="$val" ;;
      PLAN_REVIEWERS)   [ "$from_env_plan" = 1 ] || SHIP_FEATURE_PLAN_REVIEWERS="$val" ;;
      # HOW LONG a reviewer gets, from the same file for the same reason as WHO reviews and WHAT
      # they run. pr-review-relay reads this key already; ship-feature did not, so `AGENT_TIMEOUT`
      # in that file configured one tool of the two and every plan review silently kept the old
      # default. That is not a loud failure — a timed-out reviewer exits 3 and says so — but the
      # round returns no findings, and "no findings" reads exactly like a clean plan.
      #
      # Mapped onto SHIP_FEATURE_PLAN_TIMEOUT because that is the name the resolver at the top of
      # cmd_plan_review actually reads; mapping it onto PR_RELAY_AGENT_TIMEOUT would put an
      # environment value on top of the relay's own config, which MODEL_opencode below exists to
      # warn against.
      #
      # A PLAIN ASSIGNMENT, never `export` — unlike the model pins, which have to cross into the
      # pr-review-relay child. This must NOT: the relay reads this same file itself, and pushing a
      # value at it would beat its own config.
      #
      # `export -n` first, because a plain assignment does NOT clear an inherited export attribute.
      # A caller that exported the name (even empty) would otherwise have this resolved value cross
      # into the child anyway, quietly defeating the line above.
      AGENT_TIMEOUT)
        if [ "$from_env_timeout" != 1 ]; then
          export -n SHIP_FEATURE_PLAN_TIMEOUT 2>/dev/null || true
          SHIP_FEATURE_PLAN_TIMEOUT="$val"
        fi ;;
    esac
  done < "$cfg"
}

default_branch() {
  # refs/remotes/origin/HEAD -> the ref it points to, minus the "origin/" remote prefix.
  # Strip only the remote prefix (not everything up to the last /) so branch names containing '/'
  # (e.g. "release/main") survive.
  local ref
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || return 1
  ref="${ref#refs/remotes/origin/}"
  printf '%s\n' "$ref"
}

cmd_preflight() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git working tree."
  load_config
  local worktree_root="${SHIP_FEATURE_WORKTREE_ROOT:-.claude/worktrees}"
  worktree_root="${worktree_root%/}"   # tolerate a trailing slash (else the "/root/" match breaks)
  # Default the excluded marker to the TOP component of the worktree root so they always correspond —
  # otherwise a custom root (e.g. ".worktrees") could pass while an unrelated ".claude/" is what's ignored.
  local exclude_marker="${SHIP_FEATURE_EXCLUDE_MARKER:-${worktree_root%%/*}/}"

  local def cur common_dir git_dir top
  def=$(default_branch) || die "cannot resolve origin/HEAD (the default branch). Run: git remote set-head origin -a"
  ok "default branch: $def"

  cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || die "cannot read current branch."
  [ "$cur" != "HEAD" ] || die "detached HEAD — check out a named feature branch before implementing."
  [ "$cur" != "$def" ] || die "you are on the default branch '$def' — create a feature branch/worktree first."
  ok "on feature branch: $cur"

  # Linked worktree: --git-dir and --git-common-dir are identical in the main tree and differ in a
  # linked worktree. (More robust than matching "/worktrees/" in the path, which a repo cloned under a
  # directory literally named "worktrees" would trip.)
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null)
  common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  # `CDPATH=` disables CDPATH lookups and the `./` prefix stops a value like `-` being read as an option.
  case "$common_dir" in /*) : ;; *) common_dir=$(CDPATH= cd "./$common_dir" 2>/dev/null && pwd) ;; esac
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    ok "in a linked worktree"
  else
    die "not in a linked worktree — use 'git worktree add' (never work in the main tree)."
  fi

  # Worktree lives under the configured root (a workflow requirement, not just advice).
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  case "$top" in
    *"/$worktree_root/"*) ok "worktree under $worktree_root/" ;;
    *) die "worktree is not under $worktree_root/ — create it there (or set SHIP_FEATURE_WORKTREE_ROOT)." ;;
  esac

  # The marker must actually be IGNORED — ask git, don't grep the exclude file (a commented or negated
  # rule would pass a grep but not real ignore behavior). check-ignore consults .gitignore + info/exclude.
  local probe="${exclude_marker%/}/.ship-feature-probe"
  if git check-ignore -q "$probe" 2>/dev/null; then
    ok "$exclude_marker is git-ignored"
  else
    die "$exclude_marker is not ignored — add it to $common_dir/info/exclude (or .gitignore)."
  fi

  # The default-branch tracking ref must be fetched to compare against it.
  git rev-parse --verify --quiet "origin/$def" >/dev/null 2>&1 || die "cannot resolve origin/$def — run 'git fetch' first."

  # Ancestry: the feature branch must actually descend from the current default branch.
  if git merge-base --is-ancestor "origin/$def" HEAD 2>/dev/null; then
    ok "branch descends from origin/$def"
  elif git merge-base "origin/$def" HEAD >/dev/null 2>&1; then
    if [ -n "${SHIP_FEATURE_ALLOW_BEHIND:-}" ]; then
      warn "branch is behind or diverged from origin/$def — allowed via SHIP_FEATURE_ALLOW_BEHIND."
    else
      die "branch is behind or diverged from origin/$def — rebase onto the default branch, or set SHIP_FEATURE_ALLOW_BEHIND=1 to proceed on a stale base."
    fi
  else
    die "no common history with origin/$def — did you branch off the default branch?"
  fi

  echo "✔ preflight passed."
}

cmd_relay() {
  command -v pr-review-relay >/dev/null 2>&1 || die "pr-review-relay not found on PATH (it is a dependency: https://github.com/hamen/pr-review-relay)."
  load_config
  # If the caller omitted --reviewers and a quorum is configured, inject it (still fully overridable by
  # passing --reviewers yourself). stdout and the exact exit code are always preserved.
  local a has_reviewers=0
  for a in "$@"; do case "$a" in
    --reviewers) has_reviewers=1 ;;
    # pr-review-relay only accepts the two-token form; reject the =form with a clear message rather than
    # passing it through and letting the relay die with "unknown arg".
    --reviewers=*) die "pass reviewers as two tokens: --reviewers <list> (the --reviewers=... form isn't supported)." ;;
  esac; done
  if [ "$has_reviewers" = 1 ]; then
    pr-review-relay "$@"
  elif [ -n "${SHIP_FEATURE_REVIEWERS:-}" ]; then
    pr-review-relay "$@" --reviewers "$SHIP_FEATURE_REVIEWERS"
  else
    echo "  note: no explicit --reviewers and SHIP_FEATURE_REVIEWERS is unset — the relay may run a thinned panel. Set your quorum for a fail-closed cross-review." >&2
    pr-review-relay "$@"
  fi
  local rc=$?
  # Workflow-policy reminder only (on stderr, so it never pollutes the forwarded stdout).
  case "$rc" in
    # NOT "every reviewer ran": a benched (out-of-quota) reviewer is dropped deliberately and the run
    # still exits 0, so this message must not claim a full panel. And the loop rule is no longer
    # "resolve every Should-fix" — only qualifying ones open a round. The tool telling the operator
    # the old rule out-ranks any document, so it says the same thing WORKFLOW.md does — including
    # UNDISPUTED, without which it would push agents into re-rounds on findings the rule sends to Gate 2.
    0) echo "  → relay: every DISPATCHED reviewer ran (exit 0) — check the startup lines for a benched seat. NOT approval: READ the verdicts, resolve every Blocker and every UNDISPUTED qualifying Should-fix (correctness / safety / deployability / verification) — a disputed classification does not block the loop, it goes to Gate 2." >&2 ;;
    3) echo "  → relay: round not clean (exit 3) — do not trust these reviews, re-run." >&2 ;;
    4) echo "  → relay: round cap reached (exit 4) — stop and escalate to a human." >&2 ;;
  esac
  return $rc
}

# --- plan review (step 2 of the workflow) ------------------------------------
# Fan an implementation PLAN out to a panel of agents for a read-only review, BEFORE
# any code is written — the cheap gate that catches wrong assumptions and stale facts.
# Unlike `relay` (which reviews a PR via pr-review-relay and posts comments), this
# reviews a local plan file / stdin and prints each review to the terminal. Nothing
# is posted anywhere; nothing is written.
#
# Supported reviewers are ONLY those that can be run genuinely read-only over the plan
# text: claude (--permission-mode plan + --safe-mode, so no checkout hooks/plugins/MCP
# load either), codex (--sandbox read-only), cursor (--mode=ask,
# Q&A, on a model pinned away from Cursor's Auto — see CURSOR_REVIEW_MODEL below),
# kimi3 (Kimi K3 via opencode, model pinned away from the bundled default via
# KIMI3_REVIEW_MODEL — see below — and pinned read-only by OPENCODE_CONFIG_CONTENT — opencode's
# highest-precedence config layer — denying `edit`+`bash` so nothing can be written even via
# shell, reading the checkout unless it carries its own opencode config, plus `--pure` and
# `--agent plan`). agy, bare `opencode`, and bare `grok`
# name are RELAY-ONLY here — agy has no read-only mode (its relay flag disables ALL permissions)
# and a bare `opencode run` uses the all-allow build agent — so if listed they are skipped
# with a warning, never run. That keeps the "read-only, nothing is written" guarantee true
# for the whole set that actually runs.
plan_tool_for() { case "$1" in
  claude) echo claude;; codex) echo codex;; cursor) echo cursor-agent;; kimi3) echo opencode;;
  grok45high) echo grok;; *) echo "";; esac; }
# Named but deliberately not run in plan-review (available in `relay`). Note: `kimi3` IS a
# supported plan reviewer (read-only plan agent); only the bare `opencode` name is relay-only.
# Bare `grok` is the PR-relay reviewer (medium effort in pr-review-relay); plan-review uses
# `grok45high` (high effort). Listing bare `grok` here is skipped so a
# SHIP_FEATURE_REVIEWERS fallback that includes `grok` does not fail the plan panel.
plan_relay_only() { case "$1" in opencode|antigravity|agy|grok) return 0;; *) return 1;; esac; }

cmd_plan_review() {
  load_config
  # Parallel by default: the reviewers are independent, so sequencing them only serializes
  # their timeouts. --sequential is the opt-out; --parallel is kept as a no-op so existing
  # scripts and docs that pass it keep working.
  local reviewers="" file="" parallel=1 have_file=0 have_reviewers=0
  while [ $# -gt 0 ]; do
    case "$1" in
      # Guard $2 so a trailing `--reviewers` (or one followed by a flag) is a clean usage
      # error, not a `set -u` unbound-variable crash.
      --reviewers)   [ $# -ge 2 ] || die "--reviewers needs a list (e.g. --reviewers codex,kimi3)."
                     case "$2" in -*) die "--reviewers needs a list, got the flag '$2'.";; esac
                     reviewers="$2"; have_reviewers=1; shift 2;;
      --reviewers=*) die "pass reviewers as two tokens: --reviewers <list> (the --reviewers=... form isn't supported)." ;;
      --parallel)    parallel=1; shift;;   # already the default; accepted so old callers don't break
      --sequential)  parallel=0; shift;;
      -h|--help)     echo "usage: ship-feature plan-review [<plan-file>] [--reviewers a,b,c] [--sequential]"
                     echo "       the panel runs in parallel by default (--parallel still accepted; last flag wins)"; return 0;;
      # Everything after `--` is positional — collect the plan file from there too, don't drop it.
      --)            shift; while [ $# -gt 0 ]; do [ "$have_file" = 0 ] || die "only one plan file may be given."; file="$1"; have_file=1; shift; done; break;;
      -)             [ "$have_file" = 0 ] || die "only one plan file may be given (got '$file' and '-')."; file="-"; have_file=1; shift;;   # '-' = read stdin
      -*)            die "unknown arg: $1" ;;
      *)             [ "$have_file" = 0 ] || die "only one plan file may be given (got '$file' and '$1')."; file="$1"; have_file=1; shift;;
    esac
  done

  # Resolve the plan text. Explicit `-` means "read stdin" even on a TTY (and never
  # falls back to ./plan.md). An explicit file wins next. Otherwise read stdin if it is
  # a pipe; an EMPTY pipe (common in CI / subprocesses) must NOT shadow ./plan.md, so
  # fall back to it when stdin yielded nothing.
  local plan="" src=""
  if [ "$have_file" = 1 ] && [ "$file" = "-" ]; then
    plan="$(cat)"; src="(stdin)"
    [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] || die "no plan on stdin (you passed '-')."
  elif [ "$have_file" = 1 ]; then
    [ -f "$file" ] || die "plan file not found: $file"
    plan="$(cat -- "$file")"; src="$file"
    [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] || die "plan file is empty: $file"
  else
    if [ ! -t 0 ]; then plan="$(cat)"; [ -n "$(printf '%s' "$plan" | tr -d '[:space:]')" ] && src="(stdin)"; fi
    # `./plan.md` is still read when it is there — breaking existing setups to
    # make a point would be worse than the point. But it is no longer SUGGESTED:
    # the message names the durable directory instead, because a plan in the cwd
    # is usually a plan in the repository, and always a plan a `rm -rf` of a
    # worktree takes with it.
    if [ -z "$(printf '%s' "$plan" | tr -d '[:space:]')" ] && [ -f plan.md ]; then
      plan="$(cat plan.md)"; src="plan.md"
      sf_ensure_plans_dir
      printf '  ! reading ./plan.md — keep plans in %s instead (see WORKFLOW.md §1)\n' "$SF_PLANS_DIR" >&2
    fi
    if [ -z "$(printf '%s' "$plan" | tr -d '[:space:]')" ]; then
      sf_ensure_plans_dir
      die "no plan given — pass a file (keep it in $SF_PLANS_DIR) or pipe it on stdin."
    fi
  fi

  # Panel: --reviewers > SHIP_FEATURE_REVIEWERS > refuse. The resolved panel is your
  # QUORUM: every named+supported reviewer is required (a missing CLI fails the round),
  # so a review never silently passes on a thinned panel. agy/opencode are the exception.
  # An explicit but empty `--reviewers ""` is a usage error, not a silent fall-through to
  # the env panel (which would surprise a user who meant to name a list).
  if [ "$have_reviewers" = 1 ]; then
    [ -n "$reviewers" ] || die "--reviewers was empty — name at least one (e.g. --reviewers codex,kimi3)."
  else
    # Plan review can want a different (usually smaller) panel than the PR cross-review:
    # SHIP_FEATURE_PLAN_REVIEWERS is preferred, falling back to the shared quorum.
    reviewers="${SHIP_FEATURE_PLAN_REVIEWERS:-${SHIP_FEATURE_REVIEWERS:-}}"
    [ -n "$reviewers" ] || die "no reviewers — pass --reviewers <list> or set SHIP_FEATURE_PLAN_REVIEWERS / SHIP_FEATURE_REVIEWERS (e.g. claude,codex)."
  fi

  # Portable timeout: GNU `timeout`, else Homebrew `gtimeout`, else run WITHOUT a limit
  # (stock macOS ships neither) — a missing timeout must never break the reviewer.
  local TIMEOUT_BIN; TIMEOUT_BIN="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
  # 500, matching pr-review-relay's own default. The panel runs reasoning models at high
  # effort; 300 was tuned when it did not, and an ordinary plan no longer fits — grok45high
  # timed out three times in one session on a plan whose only fault was being thorough.
  #
  # The ladder, highest first: this variable (environment, then ~/.config/ship-feature/config),
  # then PR_RELAY_AGENT_TIMEOUT from the environment, then AGENT_TIMEOUT from
  # ~/.config/pr-review-relay/config (mapped onto this name by load_shared_panel_config), then
  # this literal. Rung 3 has to stay: without it a machine that exports PR_RELAY_AGENT_TIMEOUT
  # gets that value in the relay and the shared file's value here — two tools, two timeouts.
  local timeout_s="${SHIP_FEATURE_PLAN_TIMEOUT:-${PR_RELAY_AGENT_TIMEOUT:-500}}"
  # Reject non-digits AND values that are numerically zero ("0", "00", …): GNU
  # `timeout 0` DISABLES the timeout, the opposite of the intent. 10# forces base-10 so
  # a leading zero isn't read as octal.
  case "$timeout_s" in ''|*[!0-9]*) die "invalid SHIP_FEATURE_PLAN_TIMEOUT: '$timeout_s' (want a positive integer)";; esac
  [ "$((10#$timeout_s))" -gt 0 ] || die "invalid SHIP_FEATURE_PLAN_TIMEOUT: '$timeout_s' (must be > 0)"

  local PROMPT
  PROMPT="$(printf '%s' \
'You are reviewing an IMPLEMENTATION PLAN (provided on stdin), BEFORE any code is written.
Judge it for: wrong assumptions, stale or incorrect facts about the codebase, missing edge
cases, unhandled failure modes, risky or out-of-order steps, and anything it overlooks.
You have read-only access — do NOT write code or modify anything. Be concise. Group findings
by severity: Blocker / Should-fix / Nit. If the plan is sound, say so in one line.
You can read ONLY the current checkout. A plan that cites another repository, a dashboard or
an external service is not an invitation to go looking: those claims cannot be checked here,
so say the claim is unverified and move on. Do not spend the review trying to reach them —
a run that ends hunting for a file outside the checkout produces no review at all.
BUDGET YOUR TIME: you are cut off after a few minutes, and a run that is still reading files
when the clock stops delivers NOTHING — which is worse than a review with two claims left
unchecked. Verify only what could change your verdict, then stop reading and write. If you
have found something serious, write it down before you go looking for the next thing.')"

  echo "▶ Plan review — reviewers: $reviewers${src:+ — plan: $src}$([ "$parallel" = 1 ] || printf ' — sequential')" >&2

  # Per-reviewer state lives in files so it survives the subshells used under --parallel
  # (same technique as pr-review-relay). The EXIT trap removes the dir; the INT/TERM trap
  # (below) tears down the reviewer process trees so an interrupt doesn't leave agents
  # running and burning credits.
  # umask 077 so the buffered review/diagnostic/status temp files created below are 0600 —
  # defence in depth on a shared machine, on top of the 0700 dir mktemp gives us. Not
  # restored: this is the CLI's terminal command, the process exits right after.
  umask 077
  # NOT `local`. The trap body below is single-quoted, so "$STATUS_DIR" is expanded when the trap
  # fires at EXIT — which happens after this function has already returned. A function-local would
  # be gone by then, `set -u` (line 19) would abort the trap body on the unbound name, and `rm`
  # would never run: the directory, holding every reviewer's buffered output, would survive every
  # single run. It did, ~310 a day, until this was found.
  STATUS_DIR="$(mktemp -d)" || die "cannot create temp dir"
  # (`trap "rm -rf -- $(printf '%q' "$STATUS_DIR")" EXIT` would be quote-safe AND allow `local`
  # again, removing the landmine above. Not taken: it trades a one-word fix for a subtler line, and
  # the regression test in test-ship-feature.sh already turns a relapse into two loud failures.)
  # Single-quoted trap body, double-quoted var: evaluated safely at exit even if a path
  # ever held a quote. Baking the path in with a double-quoted body would work only while the path
  # holds no single quote, which is exactly what this form was written to survive.
  # `--` so a TMPDIR that legitimately starts with '-' cannot have its path parsed as options.
  trap 'rm -rf -- "$STATUS_DIR"' EXIT
  # On interrupt, tear down the parallel reviewers so they don't keep burning credits.
  # kill_tree walks each backgrounded job's whole descendant tree (subshell → $() →
  # timeout → agent), which a group-kill can't reach because `timeout` re-groups its child.
  # `trap -` first, so a second ^C exits immediately.
  trap 'trap - INT TERM; for j in $(jobs -p 2>/dev/null); do kill_tree "$j"; done; exit 130' INT TERM
  skey() { printf 'k_%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"; }

  # Run a reviewer command under the timeout when one is available, else directly.
  run_reviewer() { if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" "$timeout_s" "$@"; else "$@"; fi; }

  # Pin the Cursor reviewer's model. Left unset, cursor-agent falls back to whatever
  # ~/.cursor/cli-config.json holds — typically "Auto", which routes to the frontier models and is
  # free to pick a CLAUDE one. This command reviews a plan that Claude usually wrote, right before
  # the human approves it: Claude grading its own plan while the panel labels it an independent
  # "Cursor" reviewer defeats the point of the gate. (It also bills Cursor's small "Other Models"
  # quota instead of the much larger Cursor-branded pool.) composer-2.5 is Cursor's own model:
  # Cursor-pool, and not Claude, GPT, Codex or Grok, so every reviewer on the panel stays on the
  # model its own vendor built and they keep failing differently from each other.
  # Deliberately NOT named SHIP_FEATURE_*: it describes the user's Cursor account rather than this
  # tool, pr-review-relay reads the same variable, and one setting should configure both. It is
  # still read from the config file (load_config exports it there, so the child process sees it);
  # the environment keeps winning over the file.
  # `local` still reads the inherited/exported value on the RHS before the shadow takes effect, so
  # the override survives and nothing leaks to global scope. It is safe here only because this
  # variable is read inside the function and nowhere else; anything a trap expands must NOT be
  # local, since traps fire once the function has already returned.
  local CURSOR_REVIEW_MODEL="${CURSOR_REVIEW_MODEL:-composer-2.5}"

  # Pin the kimi3 reviewer's model. Same override pattern as CURSOR_REVIEW_MODEL above: config
  # file or environment, local so the override survives without leaking to global scope. Left
  # unset in BOTH, it falls back to the bundled OpenCode Go tier — put
  # KIMI3_REVIEW_MODEL=openrouter/<vendor>/<model> in the config file to route through a
  # pay-as-you-go OpenRouter model instead. This seat is where Kimi K3 and GLM sit, and which
  # one is better is a property of the code under review, not of the seat: GLM won a measured
  # bake-off on a Kotlin diff, while Rails' own AI evals put Kimi K3 24 points ahead on Rails
  # tasks. That is a line in a config file, which is the point of it being there.
  local KIMI3_REVIEW_MODEL="${KIMI3_REVIEW_MODEL:-opencode-go/kimi-k3}"

  # Pin the grok45high reviewer's model. Same override pattern as CURSOR_REVIEW_MODEL and
  # KIMI3_REVIEW_MODEL above: config file or environment, local so the override survives without
  # leaking to global scope. Defaults to grok-4.6 (xAI released it 2026-08-12); set
  # GROK45HIGH_REVIEW_MODEL=grok-<version> in the config file to pin a different one without
  # editing this script.
  local GROK45HIGH_REVIEW_MODEL="${GROK45HIGH_REVIEW_MODEL:-grok-4.6}"

  # Does the checkout carry its own opencode configuration?
  #
  # kimi3 reads the tree it reviews, which means the tree could otherwise reconfigure the
  # reviewer — MCP servers, agents, model routing. Permissions are already pinned by
  # OPENCODE_CONFIG_CONTENT and cannot be overridden, but nothing else is, and there is no
  # permission key for "ignore this repo's config". So when one of these exists the seat
  # degrades to an isolated empty dir instead.
  #
  # Prints the path of the first config found and returns 0; returns 1 when nothing is found.
  #
  # WALKS UP from $PWD, rather than checking one directory: plan-review is often run from a
  # subdirectory and opencode discovers config by walking up, so a $PWD-only check would miss a
  # config that opencode still loads. Stopping at the GIT ROOT is not enough either — this
  # workflow's own worktrees live at <repo>/.claude/worktrees/<name>, which is its own git
  # toplevel, so the main repo's opencode.json sits three levels up and outside that root.
  #
  # It STOPS AT $HOME, exclusive, and that bound is not a detail. `~/.opencode` exists on any
  # machine that has run opencode, so walking to / matches the user's own data directory for
  # every checkout under $HOME and degrades every review to prose. The distinction is whose
  # config it is: the user's own configuration is how the seat gets a model at all and is
  # trusted by construction; what must not configure the reviewer is the tree being REVIEWED.
  # Both paths are RESOLVED before comparing. A raw string compare misses a $HOME with a
  # trailing slash, and misses a symlinked $HOME against a physical $PWD — and the cost of
  # missing is not a warning, it is `~/.opencode` matching and every review silently degrading
  # to prose, which is the failure this bound exists to prevent.
  kimi3_repo_config() {
    local dir f home="" stop="" main=""
    dir="$(cd "$PWD" 2>/dev/null && pwd -P)" || dir="$PWD"
    [ -n "${HOME:-}" ] && home="$(cd "$HOME" 2>/dev/null && pwd -P)"
    # opencode stops project-config discovery at the worktree root (1.18.18), so walking past it
    # would degrade reviews over a config opencode never loads — and a needless prose-only review
    # is the very failure this change exists to end. Bound the walk there.
    stop="$(git rev-parse --show-toplevel 2>/dev/null && :)" || stop=""
    [ -n "$stop" ] && stop="$(cd "$stop" 2>/dev/null && pwd -P)"
    while :; do
      { [ -n "$home" ] && [ "$dir" = "$home" ]; } && return 1
      for f in opencode.json opencode.jsonc .opencode; do
        if [ -e "$dir/$f" ]; then printf '%s' "${dir}/${f}"; return 0; fi
      done
      [ -n "$stop" ] && [ "$dir" = "$stop" ] && break
      [ "$dir" = "/" ] && return 1
      dir="$(dirname "$dir")"
    done
    # A LINKED worktree is its own toplevel, so the loop above never sees the main checkout —
    # and this workflow puts every worktree at <repo>/.claude/worktrees/<name>, i.e. inside the
    # repo whose config we are guarding against. Check that root explicitly rather than by
    # walking, so the bound above stays honest.
    main="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
    [ -n "$main" ] || return 1
    main="$(cd "$(dirname "$main")" 2>/dev/null && pwd -P)" || return 1
    [ "$main" = "$dir" ] && return 1
    for f in opencode.json opencode.jsonc .opencode; do
      if [ -e "$main/$f" ]; then printf '%s' "${main}/${f}"; return 0; fi
    done
    return 1
  }

  # Both the review (stdout) and the diagnostics (stderr-bound) are buffered to files, so
  # under --parallel neither the reviews nor the failure messages interleave; the caller
  # emits them in panel order after the barrier. kimi3 cannot modify your working tree: it pins
  # read-only through OPENCODE_CONFIG_CONTENT (opencode's highest-precedence config layer, applied
  # last so it wins over any merged global/project config) denying `edit`+`bash`, unsets any
  # inherited OPENCODE_CONFIG* so a hostile env can't pre-seed "allow", and adds --pure +
  # --agent plan. It reads the checkout (that is the point of a reviewer) unless the checkout
  # carries its own opencode config, in which case it degrades to an isolated empty dir.
  # Note: like every reviewer here, opencode still writes its own session data under its data
  # dir — the guarantee is "your checkout is untouched", not "nothing touches disk".
  plan_review_with() {
    local name="$1" out rc=0 errf key Name why ro_cwd="" prompt_file expected_bytes actual_bytes body sandbox_hint="" sandbox_unenforced="" degraded_note="" repo_opencode_config=""
    key="$(skey "$name")"; errf="$STATUS_DIR/err_$key"       # in STATUS_DIR so it can't leak
    Name="$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"
    case "$name" in
      claude) out=$(printf '%s' "$plan" | run_reviewer claude -p --permission-mode plan --safe-mode "$PROMPT" 2>"$errf"); rc=$?;;
      codex)  out=$(printf '%s' "$plan" | run_reviewer codex exec --sandbox read-only "$PROMPT" 2>"$errf"); rc=$?;;
      cursor) out=$(printf '%s\n\n---\n%s' "$PROMPT" "$plan" | run_reviewer cursor-agent -p --mode=ask --model "$CURSOR_REVIEW_MODEL" 2>"$errf"); rc=$?;;
      kimi3)  # Pin read-only via OPENCODE_CONFIG_CONTENT — the HIGHEST-precedence config layer
              # (it is applied last, so it wins over any merged global/project/OPENCODE_CONFIG value;
              # verified: it overrides even a project opencode.json that sets edit/bash "allow").
              # Denying `edit`+`bash` removes those tools entirely, so nothing can be written — not
              # via a file edit, not via shell. We also unset any INHERITED OPENCODE_CONFIG* so a
              # hostile environment can't pre-seed an "allow". `--pure` skips external plugins;
              # `--agent plan` is defense in depth.
              #
              # RUNS IN THE CHECKOUT, like claude, codex, cursor and grok45high — and that is a
              # change. It used to run in an empty dir outside any checkout, which made the seat
              # useless in practice: with no tree to read, the model spends its turn hunting for
              # the repo, hits `permission requested: external_directory (…); auto-rejecting`, and
              # returns an empty review. Observed twice on 2026-08-14. A reviewer that cannot read
              # the code cannot catch a stale line number or a claim the source contradicts, which
              # is the entire reason for a panel.
              #
              # The isolation existed for one concrete reason: a repo's own opencode.json would be
              # discovered from the cwd. That reason is kept, not dropped — when the checkout ships
              # its own opencode config we fall back to the isolated empty dir and SAY SO in the
              # panel output, exactly as grok45high degrades when its sandbox cannot be enforced.
              # So the tree being reviewed can never reconfigure the reviewer reading it.
              #
              # Note the denial is belt and braces even in the checkout: the hostile-env test
              # proves OPENCODE_CONFIG_CONTENT wins over a project config that sets edit/bash
              # "allow". The fallback is about everything ELSE a repo config can carry (MCP
              # servers, agents, model routing), which no permission key covers.
              #
              # Two more denials, both learned by watching the seat fail with a tree to read:
              #
              #   external_directory — a rejected external read is FATAL to the run, not a tool
              #     that quietly returns nothing. Reviewing a plan that mentions another repo,
              #     the model reached for it, got auto-rejected, and the whole review ended
              #     there. Denying it up front (plus the prompt line telling reviewers that
              #     cross-repo claims are simply unverifiable here) keeps the turn alive.
              #   task — the plan agent can spawn parallel explore subagents, and it does. That
              #     is how a review that was verifying real claims against real files still
              #     produced nothing: it spent the whole per-reviewer budget in delegation and got cut off
              #     mid-sweep. The cap is not negotiable, so the fan-out has to go.
              #   lsp — a language server is a PROCESS the project starts, configured by the
              #     project. Denying bash and edit while leaving this on means the checkout can
              #     still run code; the seat's guarantee is that the reviewed tree executes
              #     nothing, so it goes too.
              #   webfetch + websearch — webfetch was "allow", and that was safe only while the
              #     seat had nothing to read. A reviewer that can read the tree AND reach the
              #     network is an exfiltration path the moment a file in that tree contains an
              #     instruction: these repos carry committed keystores and cached secrets. Both
              #     go, not just fetch — a search query carries content outward exactly as well
              #     as a URL does, and the enforcement here lives in the permission layer, not
              #     in the prompt asking nicely. The prompt tells reviewers not to chase
              #     external claims anyway, so this costs nothing.
              #
              # Both keys are in opencode's PermissionConfig schema (bash, doom_loop, edit,
              # external_directory, glob, grep, list, lsp, question, read, skill, task,
              # todowrite, webfetch, websearch) — checked, not guessed, because an unknown key
              # here would be ignored silently and the seat would keep failing the same way.
              ro_cwd=""
              if repo_opencode_config="$(kimi3_repo_config)"; then
                # FAIL CLOSED. If the isolated dir cannot be created, the alternative is running
                # in the very checkout whose config we just refused to load — while the note
                # below tells the reader it was isolated. Skip the seat instead: a missing
                # reviewer is visible, a lying one is not.
                if ! ro_cwd="$(TMPDIR=/tmp mktemp -d 2>/dev/null || mktemp -d)" || [ -z "$ro_cwd" ]; then
                  printf '  ! %s: %s found and no isolated cwd could be created — seat skipped\n' \
                    "$name" "$repo_opencode_config" > "$STATUS_DIR/diag_$key"
                  echo fail > "$STATUS_DIR/$key"; return 0
                fi
                degraded_note="! $repo_opencode_config would configure the reviewer — this review saw the plan text ONLY, not the code"
              fi
              out=$(cd "${ro_cwd:-$PWD}" \
                    && unset OPENCODE_CONFIG OPENCODE_CONFIG_DIR \
                    && export OPENCODE_CONFIG_CONTENT='{"permission":{"edit":"deny","bash":"deny","webfetch":"deny","websearch":"deny","external_directory":"deny","task":"deny","lsp":"deny"}}' \
                    && printf '%s\n\n--- PLAN ---\n%s' "$PROMPT" "$plan" \
                       | run_reviewer opencode run --pure --agent plan -m "$KIMI3_REVIEW_MODEL" 2>"$errf"); rc=$?
              [ -n "$ro_cwd" ] && rm -rf "$ro_cwd"
              true;;
      grok45high)
              # Grok headless ignores stdin: plan goes in --prompt-file (kept in STATUS_DIR, never
              # in the checkout, so it can't show up in anyone's `git status`).
              #
              # Runs in the CURRENT cwd — the checkout — exactly like claude, codex and cursor, so
              # it can verify the plan's claims against the code instead of reviewing prose. That
              # is the whole point of the panel: the reviewers that read the tree are the ones that
              # catch a stale line number or a test the change would turn red. The trade-off is the
              # same one those three already make: a checkout-scoped config (here `.grok`) is
              # loaded, just as CLAUDE.md / AGENTS.md / .cursor are for the others.
              #
              # Read-only is enforced by an ALLOWLIST: `--tools` names the only BUILT-INS the
              # session gets, which is what keeps out `run_terminal_command` (shell),
              # `search_replace` (editor), `spawn_subagent` and `scheduler_*`. A denylist would
              # have to enumerate every write path correctly, and an unknown name in
              # `--tools`/`--deny` is accepted silently, so a typo there fails OPEN.
              #
              # `--disallowed-tools search_tool,use_tool` is NOT redundant: the MCP bridge
              # survives the built-in allowlist. Verified — with `--tools read_file` alone the
              # session still reports `search_tool` and `use_tool`, i.e. every MCP server
              # configured on the machine stays reachable, including ones that write. With the
              # two removed, the session reports exactly read_file/list_dir/grep.
              #
              # Residual risk, stated because there is no flag for it: a checkout can still
              # contribute `.grok` config, hooks and plugins (`grok inspect` shows what a
              # directory yields). Grok has no `--safe-mode` equivalent to suppress them. What
              # remains is bounded by everything above — no shell tool, no MCP bridge, plan mode,
              # OS sandbox — but "runs code from the tree it reviews" is the same bet the other
              # in-checkout reviewers already make, not a guarantee we can make stronger here.
              # --permission-mode plan overrides machine always-approve; --sandbox read-only
              # is the OS write barrier (needs a working sandbox / bwrap on Linux). Note it can
              # warn and continue unenforced if setup fails, so it is a layer, not the guarantee.
              # High effort is the plan-review posture; PR relay uses bare `grok` (medium).
              # PREVENTION, not just detection. Grok's own docs: a BUILT-IN profile that fails to
              # apply "logs a warning and continues without enforcement" — and by the time that
              # warning reaches us the checkout's hooks and plugins have already run. Discarding
              # the review afterwards is a signal, not a barrier. So refuse to START when the OS
              # barrier cannot be applied: on Linux that is bubblewrap plus unprivileged user
              # namespaces; macOS Seatbelt is available on all versions.
              # (Grok's fail-closed CUSTOM profiles live in ~/.grok/sandbox.toml or the
              # checkout's .grok/sandbox.toml — one is the user's own config, the other is a file
              # in someone else's repo. Neither is ours to write, hence this check instead.)
              # When it cannot be enforced we DEGRADE rather than refuse: back to the isolated
              # empty cwd with every tool denied — the posture this reviewer had before, which
              # needs no sandbox because there is nothing to write and nothing to read. You get a
              # text-only review (worse) instead of no review (worse still) or an unsandboxed one
              # in your checkout (worst).
              why=""
              case "${SHIP_FEATURE_FORCE_SANDBOX_PROBE:-}" in   # test-only override
                ok) ;;
                fail) why="forced by SHIP_FEATURE_FORCE_SANDBOX_PROBE";;
                *)
                  if [ "$(uname -s)" = Linux ]; then
                    command -v bwrap >/dev/null 2>&1 || why="bubblewrap (bwrap) not found"
                    if [ -z "$why" ] && [ -r /proc/sys/kernel/unprivileged_userns_clone ] \
                       && [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = 0 ]; then
                      why="unprivileged user namespaces are disabled"
                    fi
                  fi;;
              esac
              if [ -n "$why" ]; then
                ro_cwd="$(mktemp -d "$STATUS_DIR/iso-grok45high.XXXXXX")" || {
                  printf '  ! %s: cannot create isolated cwd (mktemp failed)\n' "$name" > "$STATUS_DIR/diag_$key"
                  echo fail > "$STATUS_DIR/$key"; return 0
                }
                degraded_note="! read-only sandbox cannot be enforced ($why) — this review saw the plan text ONLY, not the checkout"
              fi
              prompt_file="$STATUS_DIR/prompt_grok45high_$$"
              body="$(printf '%s\n\n--- PLAN ---\n~~~~plan\n%s\n~~~~\n--- END PLAN ---\n' "$PROMPT" "$plan")"
              if ! printf '%s' "$body" > "$prompt_file"; then
                printf '  ! %s: failed to write prompt-file\n' "$name" > "$STATUS_DIR/diag_$key"
                echo fail > "$STATUS_DIR/$key"; return 0
              fi
              expected_bytes=$(printf '%s' "$body" | wc -c | tr -d ' ')
              actual_bytes=$(wc -c < "$prompt_file" | tr -d ' ')
              if [ -z "$actual_bytes" ] || [ "$actual_bytes" = 0 ] || [ "$actual_bytes" != "$expected_bytes" ]; then
                printf '  ! %s: prompt-file write incomplete (expected %sB, got %sB)\n' \
                  "$name" "$expected_bytes" "${actual_bytes:-0}" > "$STATUS_DIR/diag_$key"
                echo fail > "$STATUS_DIR/$key"; [ -n "$ro_cwd" ] && rm -rf "$ro_cwd"; return 0
              fi
              if [ -n "$ro_cwd" ]; then      # degraded: isolated, no tools, no checkout
                out=$(cd "$ro_cwd" \
                      && run_reviewer grok \
                           --prompt-file "$prompt_file" \
                           --cwd "$ro_cwd" \
                           -m "$GROK45HIGH_REVIEW_MODEL" \
                           --reasoning-effort high \
                           --permission-mode plan \
                           --deny '*' \
                           --verbatim \
                           --no-memory \
                           --no-subagents \
                           --disable-web-search \
                           --max-turns 40 \
                           </dev/null 2>"$errf"); rc=$?
                rm -rf "$ro_cwd"
              else
                out=$(run_reviewer grok \
                         --prompt-file "$prompt_file" \
                         -m "$GROK45HIGH_REVIEW_MODEL" \
                         --reasoning-effort high \
                         --permission-mode plan \
                         --sandbox read-only \
                         --tools read_file,list_dir,grep \
                         --disallowed-tools search_tool,use_tool \
                         --verbatim \
                         --no-memory \
                         --no-subagents \
                         --disable-web-search \
                         --max-turns 40 \
                         </dev/null 2>"$errf"); rc=$?
              fi
              # Backstop to the pre-flight check above, for a sandbox that fails to apply for a
              # reason we cannot probe. Checked regardless of the exit code — a sandbox complaint
              # on stderr with a perfectly good review on stdout and exit 0 is exactly the silent
              # fail-open shape, and gating this on `rc != 0` (as it once did) meant the one case
              # worth catching was the one never inspected.
              # Matched on FAILURE PHRASING, not on the bare words "sandbox"/"namespace": those
              # appear in healthy logs too, and discarding a good review over the word "namespace"
              # would train people to ignore this.
              if [ -z "$ro_cwd" ] && [ -s "$errf" ] && grep -qiE 'continu(e|ing|es) (without enforcement|unsandboxed)|(sandbox|profile)[^.]{0,40}(could not|cannot|can'"'"'t|failed to) (be )?appl|failed to (set up|start|initiali[sz]e) (the )?sandbox|sandbox (is )?unavailable|running unsandboxed' "$errf" 2>/dev/null; then
                sandbox_hint="  ! $name: sandbox unavailable (check bubblewrap / user namespaces)"
                sandbox_unenforced=1
              fi;;
    esac
    if [ -n "$sandbox_unenforced" ]; then
      { printf '  ! %s: read-only sandbox was not enforced — review discarded\n' "$name"
        printf '%s\n' "$sandbox_hint"
        [ -s "$errf" ] && tail -n 10 "$errf" | sed 's/^/    │ /'
      } > "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"; return 0
    fi
    if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
      why="exited with code $rc"
      case "$rc" in 0) why="ran but returned an empty review";; 124) why="timed out after ${timeout_s}s (raise SHIP_FEATURE_PLAN_TIMEOUT)";; 127) why="command not found";; esac
      { printf '  ! %s: no review — %s\n' "$name" "$why"
        [ -n "$sandbox_hint" ] && printf '%s\n' "$sandbox_hint"
        [ "$rc" != 124 ] && [ -s "$errf" ] && tail -n 10 "$errf" | sed 's/^/    │ /'
      } > "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"; return 0
    fi
    { printf '\n========== %s (plan review) ==========\n' "$Name"
      [ -n "$degraded_note" ] && printf '%s\n\n' "$degraded_note"
      printf '%s\n=======================================\n' "$out"
    } > "$STATUS_DIR/out_$key"
    if [ "$rc" -ne 0 ]; then
      # Name the timeout explicitly: a bare "exited with code 124" is opaque.
      if [ "$rc" = 124 ]; then printf '  ! %s: timed out after %ss — review may be truncated (not clean)\n' "$name" "$timeout_s" > "$STATUS_DIR/diag_$key"
      else printf '  ! %s: exited with code %s — review may be truncated (not clean)\n' "$name" "$rc" > "$STATUS_DIR/diag_$key"; fi
      [ -n "$sandbox_hint" ] && printf '%s\n' "$sandbox_hint" >> "$STATUS_DIR/diag_$key"
      echo fail > "$STATUS_DIR/$key"
    else echo ok > "$STATUS_DIR/$key"; fi
  }

  # Dispatch, de-duping the panel. `set -f` guards the word-split from pathname expansion
  # (an unquoted `$reviewers` would otherwise glob a value like `a*`).
  local r rk tool seen="" order=""
  local IFS_SAVE="$IFS"; set -f; IFS=','; set -- $reviewers; IFS="$IFS_SAVE"; set +f
  for r in "$@"; do
    r="$(printf '%s' "$r" | tr -d '[:space:]')"; [ -z "$r" ] && continue
    [ "$r" = "agy" ] && r=antigravity
    rk="$(skey "$r")"
    case " $seen " in *" $rk "*) continue;; esac
    seen="$seen $rk"
    if plan_relay_only "$r"; then
      if [ "$r" = grok ]; then warn "grok is relay-only here — use grok45high for plan-review (high effort); skipping.";
      else warn "$r is relay-only (no read-only mode / needs file-attach) — not run in plan-review; skipping."; fi
      continue
    fi
    tool="$(plan_tool_for "$r")"
    # A named reviewer that is unknown, or supported-but-not-installed, is a hard failure:
    # the panel is the quorum, so a review must not quietly pass with it missing.
    if [ -z "$tool" ]; then echo fail > "$STATUS_DIR/$rk"; warn "unknown reviewer '$r' → fail"; continue; fi
    if ! command -v "$tool" >/dev/null 2>&1; then echo fail > "$STATUS_DIR/$rk"; warn "$tool not installed (required by the panel) → fail"; continue; fi
    order="$order $rk"
    echo "  → $r reviewing…" >&2
    echo pending > "$STATUS_DIR/$rk"
    if [ "$parallel" = 1 ]; then
      plan_review_with "$r" &
    else
      # Sequential: run and stream this review immediately (no interleave risk), so a
      # slow first reviewer doesn't make the whole panel silent until the end.
      plan_review_with "$r"
      [ -f "$STATUS_DIR/out_$rk" ]  && cat "$STATUS_DIR/out_$rk"
      [ -f "$STATUS_DIR/diag_$rk" ] && cat "$STATUS_DIR/diag_$rk" >&2
    fi
  done
  [ "$parallel" = 1 ] && wait

  # Parallel: reviews and diagnostics were buffered per reviewer; emit them in panel
  # order now, so neither the stdout reviews nor the stderr failures interleave.
  if [ "$parallel" = 1 ]; then
    local e; for e in $order; do
      [ -f "$STATUS_DIR/out_$e" ]  && cat "$STATUS_DIR/out_$e"
      [ -f "$STATUS_DIR/diag_$e" ] && cat "$STATUS_DIR/diag_$e" >&2
    done
  fi

  # Fail-closed verdict. Only status files (k_*) are counted — out_/err_ are excluded.
  local f ran=0 failed=0 names=""
  for f in "$STATUS_DIR"/k_*; do
    [ -e "$f" ] || continue
    ran=$((ran + 1))
    if [ "$(cat "$f")" != ok ]; then failed=$((failed + 1)); names="$names ${f##*/k_}"; fi
  done
  if [ "$ran" = 0 ]; then
    die "no supported reviewers ran. plan-review supports: claude, codex, cursor, kimi3, grok45high (agy, bare opencode, and bare grok are relay-only). Pass --reviewers with a supported agent."
  fi
  if [ "$failed" -gt 0 ]; then echo "✖ Plan review NOT clean: $failed/$ran reviewer(s) failed —$names. Re-run THIS ROUND. If the SAME reviewer fails a SECOND consecutive attempt, drop that one reviewer, proceed with the rest, and tell the human about the reduced panel before Gate 1 — do not keep retrying it." >&2; return 3; fi
  echo "✔ Plan review done — $ran/$ran reviewer(s) responded (cap: 2 rounds, same full panel both times). READ the findings: no Blocker/plan-qualifying Should-fix → straight to Gate 1. Was this round 1 with a plan-qualifying finding → revise once and re-run. Was this round 2 with a plan-qualifying finding still open → do not run a round 3 on your own — write a disagreement summary (objection, classification, reason) and take it to Gate 1 instead." >&2
  return 0
}

main() {
  local sub="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    preflight)   cmd_preflight "$@" ;;
    relay)       cmd_relay "$@" ;;
    plan-review) cmd_plan_review "$@" ;;
    # Print the whole header comment block — from line 2 to the first line that is not a
    # comment. A hardcoded end line silently truncates help the moment anyone documents a new
    # flag up there, which is exactly how this broke once; the shebang is the only line skipped.
    help|-h|--help) awk 'NR>1 { if ($0 !~ /^#/) exit; print }' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $sub (try: ship-feature help)" ;;
  esac
}
main "$@"
